  "http": {
    "_why": "播放层出口白名单（精确匹配 host.equals）。cloud.yuntongclouds.com 是主 CDN，dubo.oulehdtv.tv 是少量片源。m3u8 的分片和变体清单都是同域相对路径，所以只需这两条。真机若报『主机不在播放层白名单：xxx』，把该 host 补进来。",
    "hosts": [
      "cloud.yuntongclouds.com",
      "dubo.oulehdtv.tv"
    ]
  },
  "net": {
    "_why": "【2026-11-08 更正】欧乐是面向海外华人的站，api.olelive.com / 播放 CDN / 封面图床对大陆出口一律 HTTP 403（真机实测：直连 403，走代理 200）。最初写 declared+proxy:[] 强制直连是错的——那会让整站 403、首页全空。现改为只把这些域走代理，其余直连：跟「源声明了 net.proxy，表里的域走代理」的语义一致。",
    "declared": true,
    "proxy": [
      "api.olelive.com",
      "static.olelive.com",
      "cloud.yuntongclouds.com",
      "dubo.oulehdtv.tv"
    ]
  },
